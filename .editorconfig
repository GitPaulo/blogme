root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{md,yml,yaml,json,bicep}]
indent_style = space
indent_size = 2

# Prettier formats the web app, and its useTabs wins over EditorConfig.
[web/**.json]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
