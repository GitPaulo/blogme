      "name": "titles",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": ["titleSuggest"]
    }
  ],
  "scoringProfiles": [
    {
      "name": "relevance",
      "text": {
        "weights": {
          "title": 4,
          "author": 3,
          "summary": 2,
          "content": 1,
          "topics": 1
        }
      }
    },
    {
      "name": "relevance-fresh",
      "text": {
        "weights": {
          "title": 4,
          "author": 3,
          "summary": 2,
          "content": 1,
          "topics": 1
        }
      },
      "functions": [
        {
          "type": "freshness",
          "fieldName": "publishedAt",
          "boost": 1.5,
          "interpolation": "logarithmic",
          "freshness": {
            "boostingDuration": "P1825D"
          }
        }
      ],
      "functionAggregation": "sum"
    },
    {
      "name": "relevance-quality",
      "text": {
        "weights": {
          "title": 4,
          "author": 3,
          "summary": 2,
          "content": 1,
          "topics": 1
        }
      },
      "functions": [
        {
          "type": "freshness",
          "fieldName": "publishedAt",
          "boost": 1.5,
          "interpolation": "logarithmic",
          "freshness": {
            "boostingDuration": "P1825D"
          }
        },
        {
          "type": "magnitude",
          "fieldName": "quality",
          "boost": 2,
          "interpolation": "linear",
          "magnitude": {
            "boostingRangeStart": 0,
            "boostingRangeEnd": 1,
            "constantBoostBeyondRange": false
          }
        }
      ],
      "functionAggregation": "sum"
    },
    {
      "name": "relevance-authorlight",
      "text": {
        "weights": {
          "title": 4,
          "author": 1,
          "summary": 2,
          "content": 1,
          "topics": 1
        }
      },
      "functions": [
        {
          "type": "freshness",
          "fieldName": "publishedAt",
          "boost": 1.5,
          "interpolation": "logarithmic",
          "freshness": {
            "boostingDuration": "P1825D"
          }
        },
        {
          "type": "magnitude",
          "fieldName": "quality",
          "boost": 2,
          "interpolation": "linear",
          "magnitude": {
            "boostingRangeStart": 0,
            "boostingRangeEnd": 1,
            "constantBoostBeyondRange": false
          }
        }
      ],
      "functionAggregation": "sum"
    }
  ],
  "defaultScoringProfile": "relevance-fresh",
  "semantic": {
    "defaultConfiguration": "blogme-semantic",
    "configurations": [
      {
        "name": "blogme-semantic",
        "prioritizedFields": {
          "titleField": {
            "fieldName": "title"
          },
          "prioritizedContentFields": [
            {
              "fieldName": "summary"
            },
            {
              "fieldName": "content"
            }
          ],
          "prioritizedKeywordsFields": [
            {
              "fieldName": "topics"
            }
          ]
        }
      }
    ]
  }
